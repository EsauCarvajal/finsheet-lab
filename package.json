{
  "name": "finsheet-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.14.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:install": "node scripts/e2e.mjs install",
    "capture": "node scripts/capture.mjs",
    "social-image": "node scripts/social-image.mjs",
    "notices": "node scripts/notices.mjs",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "wrangler pages deploy dist --project-name=finsheet-lab"
  },
  "dependencies": {
    "@ironcalc/wasm": "0.8.4",
    "i18next": "26.4.3",
    "idb": "8.0.4",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-data-grid": "7.0.0-beta.61",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
